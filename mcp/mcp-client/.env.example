# MCP server every framework talks to (FastAPI: 8001, Spring Boot: 8002)
MCP_SERVER_URL=http://localhost:8001/mcp
# Provider-side MCP (claude-connector, openai-hosted) needs a public tunnel URL
# PUBLIC_MCP_SERVER_URL=https://<your-tunnel>.ngrok.app/mcp

# langgraph, claude-api, claude-connector, claude-agent-sdk
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# adk (Gemini API key) ...
GOOGLE_API_KEY=
# ... or adk/vertex through Vertex AI (plus: gcloud auth application-default login)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3.5-flash

# strands, agentcore (standard AWS credential chain also works: AWS_PROFILE, SSO, ...)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=

# openai-agents, openai-hosted
OPENAI_API_KEY=
# OPENAI_MODEL=
