# Copy to .env and adjust. Every value has a safe local default, so the demo
# runs even if you never create this file.

# ---------------------------------------------------------------------------
# Unity Catalog metastore (MongoDB)
# ---------------------------------------------------------------------------
# If MONGO_URI is unset OR unreachable, the app transparently falls back to an
# in-memory mongomock instance so you can run with zero infrastructure.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=databricks_demo

# Force the in-memory catalog even if a real Mongo is running (handy for tests):
# USE_MONGOMOCK=1

# ---------------------------------------------------------------------------
# Lakehouse storage layer (real Delta tables via delta-rs)
# ---------------------------------------------------------------------------
# Directory where Delta tables are written (_delta_log + Parquet). The on-disk
# layout mirrors the namespace: <DELTA_DIR>/<catalog>/<schema>/<table>.
DELTA_DIR=./data/delta

# ---------------------------------------------------------------------------
# Databricks SQL warehouse (DuckDB)
# ---------------------------------------------------------------------------
# ":memory:" keeps the SQL engine ephemeral -- the data durability lives in the
# Delta Lakehouse, not in DuckDB. Use a file path to persist the engine state.
DUCKDB_PATH=:memory:

# ---------------------------------------------------------------------------
# Auto Loader / Structured Streaming landing zone
# ---------------------------------------------------------------------------
STAGE_DIR=./stage

# ---------------------------------------------------------------------------
# MLflow tracking + model registry
# ---------------------------------------------------------------------------
# Defaults to a sqlite DB under MLRUNS_DIR (the file store is in maintenance
# mode in MLflow 3.x). Override MLFLOW_TRACKING_URI to point at a server.
MLRUNS_DIR=./data/mlruns
# MLFLOW_TRACKING_URI=sqlite:///./data/mlruns/mlflow.db

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
