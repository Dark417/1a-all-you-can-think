# Copy to .env and adjust. Every value has a safe local default, so the demo
# runs even if you never create this file.

# ---------------------------------------------------------------------------
# Metadata catalog (MongoDB)
# ---------------------------------------------------------------------------
# If MONGO_URI is unset OR unreachable, the app transparently falls back to an
# in-memory mongomock instance so you can run with zero infrastructure.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=snowflake_demo

# Force the in-memory catalog even if a real Mongo is running (handy for tests):
# USE_MONGOMOCK=1

# ---------------------------------------------------------------------------
# Local "storage layer"
# ---------------------------------------------------------------------------
# DuckDB file that emulates Snowflake's centralized storage. ":memory:" is also
# valid but you lose persistence between restarts.
DUCKDB_PATH=./data/warehouse.duckdb

# Directory that emulates internal/external stages (where files land before COPY INTO).
STAGE_DIR=./stages

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
