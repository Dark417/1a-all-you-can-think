# BazaarLink is an OpenAI-compatible gateway: any client that accepts a
# base_url works (openai SDK, langchain-openai, ...). Key format: sk-bl-...
OPENAI_API_KEY=sk-bl-...
OPENAI_BASE_URL=https://api.bazaarlink.ai/v1

# Any id from GET /v1/models. ":free" ids need no credits; paid ids (e.g. deepseek-v4-flash) return 402 until topped up.
MODEL=qwen/qwen3.7-flash:free

PORT=8000
