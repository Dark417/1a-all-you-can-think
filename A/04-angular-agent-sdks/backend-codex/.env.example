# The Codex backend drives the `codex` CLI (npm i -g @openai/codex). Pick ONE:

# (a) native — your ChatGPT login (`codex login`) or OPENAI_API_KEY; uses ~/.codex config
CODEX_USE_OPENROUTER=false
# OPENAI_API_KEY=sk-...
# CODEX_MODEL=gpt-5-codex

# (b) OpenRouter as a custom model provider. Uses ./codex-home/config.toml
#     (CODEX_HOME is pointed there so your global ~/.codex is untouched).
# CODEX_USE_OPENROUTER=true
# OPENROUTER_API_KEY=sk-or-v1-...
# CODEX_MODEL=poolside/laguna-s-2.1:free

PORT=8002
