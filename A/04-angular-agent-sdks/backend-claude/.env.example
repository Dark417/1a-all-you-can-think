# The Claude Agent SDK drives the Claude Code CLI. Pick ONE auth path:

# (a) native — Anthropic API key (recommended; full feature support)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5

# (b) OpenRouter via its Anthropic-compatible Messages endpoint.
#     Claude Code honors ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN; the model id
#     is then an OpenRouter id. Community-documented, works for chat; some CLI
#     features (prompt caching, extended thinking) may not.
# CLAUDE_USE_OPENROUTER=true
# OPENROUTER_API_KEY=sk-or-v1-...
# CLAUDE_MODEL=poolside/laguna-s-2.1:free

PORT=8001
