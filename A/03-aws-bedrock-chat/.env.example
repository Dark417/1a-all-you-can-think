# "bedrock" = Amazon Bedrock Converse API (the point of this project)
# "openrouter" = fallback so the app runs with no AWS account
MODEL_PROVIDER=bedrock

# --- bedrock ---
# credentials come from the normal AWS chain: `aws configure`, AWS_PROFILE, env vars, SSO…
AWS_REGION=us-east-1
# AWS_PROFILE=default
# Any Converse-API model you have access to (Bedrock console -> Model access):
#   amazon.nova-lite-v1:0                            cheap, fast
#   us.anthropic.claude-3-5-haiku-20241022-v1:0      cross-region inference profile
#   meta.llama3-1-8b-instruct-v1:0
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# --- openrouter fallback (OpenAI-compatible endpoint) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=poolside/laguna-s-2.1:free

PORT=8030
