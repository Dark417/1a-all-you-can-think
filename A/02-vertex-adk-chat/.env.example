# "vertex" = Gemini on Vertex AI via Application Default Credentials (the point of this project)
# "openrouter" = fallback so the app runs with no GCP project
MODEL_PROVIDER=vertex

# --- vertex ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
# grounding with Google Search (Gemini-only built-in tool)
ENABLE_GOOGLE_SEARCH=true

# --- openrouter fallback ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=poolside/laguna-s-2.1:free

PORT=8020
