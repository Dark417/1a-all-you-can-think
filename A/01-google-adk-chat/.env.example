# Which model backend the ADK agent uses: "openrouter" (free, works today) or "gemini"
MODEL_PROVIDER=openrouter

# --- openrouter (via ADK's LiteLlm wrapper) ---
OPENROUTER_API_KEY=sk-or-v1-...
# Free models rotate; "openrouter/free" is an alias that picks whatever free model is up.
OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# --- gemini via Google AI Studio (native ADK path) ---
GOOGLE_API_KEY=AIza...
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-2.5-flash

# give the agent the get_current_time tool (some free models reject tool calls — set false then)
ENABLE_TOOLS=true
PORT=8010
